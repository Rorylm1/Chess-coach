# Chess Coach — environment variables
# Copy to .env.local and fill in. Server-side only; never expose to the client.

# Anthropic API key for the server-side coaching route (used from M3 onward).
ANTHROPIC_API_KEY=

# Optional public WebSocket override for invite-link games (baked into the build).
# The canonical production domain uses the checked-in relay when omitted.
# Localhost defaults to ws://localhost:8787/socket. Other domains require this override
# and an exact entry in the relay's ALLOWED_ORIGINS.
NEXT_PUBLIC_CHESS_RELAY_URL=

# Standalone Hetzner relay configuration (set in its service environment).
# ALLOWED_ORIGINS=https://your-chess-app.example
# HOST=127.0.0.1
# PORT=8787
# TRUST_PROXY=1  # only behind the sole trusted local reverse proxy
